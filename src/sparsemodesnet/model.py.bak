    def l1_norm_b(self):
        """Return ℓ₁-norm of ω."""
        return self.omega.abs().sum()

    @staticmethod
    def _row_inf_norm(mat: torch.Tensor) -> torch.Tensor:
        """
        Given mat: (s, h), return length-s vector of rowwise l-infinity norms.
        """
        return mat.abs().max(dim=1)[0]
    
